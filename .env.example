# Environment Configuration Example for Abay Stationery Enterprise SaaS

# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL 16 Database
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/abay_stationery_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_NAME=abay_stationery_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis 7 Cache & Queue
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=abay_stationery_jwt_secret_must_be_random_and_secure_min_32_chars!
JWT_REFRESH_SECRET=abay_stationery_refresh_secret_must_be_random_min_32_chars!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# Multi-Tenancy & Seed Safety
DEFAULT_TENANT_ID=tenant-abay
ENABLE_DEMO_RESET=true

# Fiscal Device Integration (Ethiopia MOR/ERCA)
FISCAL_PROVIDER=mock
FISCAL_DEVICE_ENDPOINT=http://localhost:8080/fiscal
FISCAL_TIMEOUT_MS=5000

# Storage (S3 / Local Object Storage for Invoices/Attachments)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=abay-stationery-docs
# S3_REGION=af-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
